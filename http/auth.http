
### Check API root
GET {{base_url}}/accounts/v1/
Authorization: Bearer {{access_token}}
Content-Type: application/json

### Register user
POST http://127.0.0.1:8000/accounts/v1/register/
Content-Type: application/json

{
  "username": "mimi",
  "email": "mimi@gmail.com",
  "password": "12345678"

}

### Login user
POST http://127.0.0.1:8000/accounts/v1/login/
Content-Type: application/json

{
  "email": "munim@gmail.com",
  "password": "12345678"
}


### Logout user
POST http://127.0.0.1:8000/accounts/v1/logout/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "refresh": "{{refresh_token}}"
}

### Profile
GET {{base_url}}/accounts/v1/profile/2/
Authorization: Bearer {{access_token}}
Content-Type: application/json

### Profile Update
PUT {{base_url}}/accounts/v1/profile/2/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{

    "bio": "Updated bio",
    "date_of_birth": "1990-01-01",
    "workplace": "Padakhep"
}

###Pending Receives Connections
GET {{base_url}}/accounts/v1/pending-received-connections/
Authorization: Bearer {{access_token}}
Content-Type: application/json

###Pending Sent Connections
GET {{base_url}}/accounts/v1/pedning-sent-connections/
Authorization: Bearer {{access_token}}
Content-Type: application/json


### Connection Request
POST {{base_url}}/accounts/v1/connection-request/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "receiver": 2
}

###Update Connection
PATCH {{base_url}}/accounts/v1/connection-update/4/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "type": "accepted "
}

###All Connections
GET {{base_url}}/accounts/v1/connections/
Authorization: Bearer {{access_token}}
Content-Type: application/json

###All Users
GET {{base_url}}/accounts/v1/users/
Authorization: Bearer {{access_token}}
Content-Type: application/json

###Conversations List
GET {{base_url}}/conversation/v1/conversations/
Authorization: Bearer {{access_token}}
Content-Type: application/json



###Create Conversation
POST {{base_url}}/conversation/v1/conversations/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "type": "DIRECT",

  "participant_id":  3
}

###Add Participant
PATCH {{base_url}}/conversation/v1/add-participants/5/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{

  "participant_ids":  [1,3,6]
}

###Remove Participant
DELETE {{base_url}}/conversation/v1/remove-participants/5/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "participant_ids":  [1,3]
}